<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.MyApplication" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#080B18</item>
        <item name="android:statusBarColor">#080B18</item>
        <item name="android:navigationBarColor">#080B18</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>

        <!-- Android 12+ Splash Screen API properties -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="s">#080B18</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="s">@drawable/ic_splash_logo</item>
        <item name="android:windowSplashScreenAnimationDuration" tools:targetApi="s">800</item>
    </style>

</resources>
